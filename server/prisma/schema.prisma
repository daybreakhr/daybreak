// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitees    Invitees[]
  Department  Department[]
  Location    Location[]
  Job         Job[]
}

model Member {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  uid         String       @unique
  role        Role
  invites     Invitees[]
  Workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  workspaceId String       @db.ObjectId
  Department  Department[]
  Location    Location[]
  Job         Job[]
}

model Invitees {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  role        Role
  token       String    @default(uuid())
  expiryDate  DateTime
  createdAt   DateTime  @default(now())
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member?   @relation(fields: [memberId], references: [id])
  memberId    String?   @db.ObjectId
}

enum Role {
  admin
  member
}

model Job {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  priority     Priority    @default(medium)
  Department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departmentId String?     @db.ObjectId
  jobType      JobType?
  Location     Location?   @relation(fields: [locationId], references: [id])
  locationId   String?     @db.ObjectId
  isRemote     Boolean     @default(false)
  description  Json?
  skills       String[]
  experience   String?
  currency     Currency?
  minSalary    Int?
  maxSalary    Int?
  isPublished  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  Workspace    Workspace   @relation(fields: [workspaceId], references: [id])
  workspaceId  String      @db.ObjectId
  Member       Member      @relation(fields: [createdBy], references: [uid])
  createdBy    String
}

enum Priority {
  high
  medium
  low
}

enum JobType {
  fullTime
  partTime
  contract
  internship
}

enum Currency {
  inr
  usd
}

model Department {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Job         Job[]
}

model Location {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Job         Job[]
}
