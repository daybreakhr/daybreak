{
  "name": "day-break",
  "private": true,
  "version": "1.0.0",
  "author": "Himanshu Nagrath <him.nagrath@gmail.com>",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern --fix \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format": "prettier \"**/*.{ts,tsx,js,jsx,json,css}\" --write",
    "client": "yarn workspace client dev",
    "server": "yarn workspace server start:dev",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint && yarn format"
    }
  },
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "packages/**/*.{tsx, ts, js, jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.36.1",
    "@typescript-eslint/parser": "^5.36.1",
    "eslint": "^8.23.0",
    "eslint-plugin-n": "^15.2.5",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-react": "^7.31.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1"
  },
  "engines": {
    "node": ">=16"
  }
}
