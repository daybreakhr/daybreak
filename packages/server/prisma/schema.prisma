// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String       @unique
  logo        String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitees    Invitees[]
  Department  Department[]
  Location    Location[]
  Job         Job[]
  Candidate   Candidate[]
  Prospect    Prospect[]
  Pipeline    Pipeline[]
}

model Member {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  uid                   String       @unique // unique id provided firebase authentication
  role                  Role
  googleRefreshToken    String?
  googleTokenExpiryTime Int?
  invites               Invitees[]
  Workspace             Workspace    @relation(fields: [workspaceId], references: [id])
  workspaceId           String       @db.ObjectId
  isSuspended           Boolean      @default(false)
  Department            Department[]
  Location              Location[]
  Job                   Job[]
  Feedback              Feedback[]
  Calendar              Calendar[]
  Email                 Email[]
  App                   App[]
  Interview             Interview[]
  Pipeline              Pipeline[]

  @@unique([App.appName])
}

model Invitees {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  role        Role
  token       String    @default(uuid())
  createdAt   DateTime  @default(now())
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [memberId], references: [uid])
  memberId    String
}

enum Role {
  admin
  member
}

model Job {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  title         String?
  priority      Priority    @default(medium)
  Department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departmentId  String?     @db.ObjectId
  jobType       JobType?
  Location      Location?   @relation(fields: [locationId], references: [id])
  locationId    String?     @db.ObjectId
  isRemote      Boolean     @default(false)
  hiringManager String? // uid of user
  hireBy        DateTime?
  description   Json?
  skills        String[]
  experience    String?
  currency      Currency?
  minSalary     Int?
  maxSalary     Int?
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Pipeline      Pipeline?   @relation(fields: [pipelineId], references: [id])
  pipelineId    String      @db.ObjectId
  Workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  workspaceId   String      @db.ObjectId
  Member        Member      @relation(fields: [createdBy], references: [uid])
  createdBy     String
  Candidate     Candidate[]
  Prospects     Prospect[]  @relation(fields: [prospectIds], references: [id])
  prospectIds   String[]    @db.ObjectId
}

enum Priority {
  high
  medium
  low
}

enum JobType {
  fullTime
  partTime
  contract
  internship
}

enum Currency {
  inr
  usd
}

model Department {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Job         Job[]
}

model Location {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Job         Job[]
}

model Template {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description Json
  category    Category
}

enum Category {
  engineering
  marketing
  sales
  it
  hr
  accounts
}

model Candidate {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  firstName        String
  middleName       String?
  lastName         String
  email            String
  phone            String
  location         String
  resume           String?
  affindaId        String          @unique
  linkedInUrl      String
  status           CandidateStatus @default(applied)
  rejectionMessage String?
  createdAt        DateTime        @default(now())
  Job              Job             @relation(fields: [jobId], references: [id])
  jobId            String          @db.ObjectId
  Workspace        Workspace       @relation(fields: [workspaceId], references: [id])
  workspaceId      String          @db.ObjectId
  Feedback         Feedback[]
  Calendar         Calendar[]
  Email            Email[]
}

enum CandidateStatus {
  applied
  interview
  offered
  accepted
  rejected
}

model Prospect {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  middleName  String?
  lastName    String
  email       String
  phone       String
  location    String
  resume      String?
  linkedInUrl String
  createdAt   DateTime  @default(now())
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Jobs        Job[]     @relation(fields: [jobIds], references: [id])
  jobIds      String[]  @db.ObjectId
}

model Feedback {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  notes       String
  score       Float
  createdAt   DateTime  @default(now())
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
}

// Details of interview round with candidate
model Interview {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Member     Member   @relation(fields: [createdBy], references: [uid])
  createdBy  String
  Pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  pipelineId String   @db.ObjectId
}

// Collection of Interviews is a Pipeline. A Saved Pipeline can be used with multiple Jobs
model Pipeline {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  isSaved     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Member      Member      @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Interview   Interview[]
  Job         Job[]
  Workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  workspaceId String      @db.ObjectId
}

model Calendar {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String    @unique // eventId from google calendar
  title       String
  startTime   DateTime
  endTime     DateTime
  attendees   String[]
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  createdAt   DateTime  @default(now())
}

model Email {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId   String    @unique // id from gmail
  subject     String
  from        String
  to          String
  body        String
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  createdAt   DateTime  @default(now())
}

type App {
  appName     AppName
  isInstalled Boolean
  createdAt   DateTime @default(now())
}

enum AppName {
  gcalendar
  gmail
}
