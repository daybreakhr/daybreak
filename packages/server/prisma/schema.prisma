// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Workspace {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String          @unique
  logo           String?
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        Member[]
  invitees       Invitees[]
  Department     Department[]
  Location       Location[]
  Job            Job[]
  Candidate      Candidate[]
  Prospect       Prospect[]
  EmailTemplates EmailTemplate[]
}

model Member {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  uid                String          @unique // unique id provided firebase authentication
  role               Role
  googleRefreshToken EncryptedData?
  slackBotToken      EncryptedData?
  slackUserId        String?
  slackBotUserId     String?
  invites            Invitees[]
  Workspace          Workspace       @relation(fields: [workspaceId], references: [id])
  workspaceId        String          @db.ObjectId
  isSuspended        Boolean         @default(false)
  Department         Department[]
  Location           Location[]
  Job                Job[]
  Feedback           Feedback[]
  Calendar           Calendar[]
  Email              Email[]
  Integration        Integration?
  Interview          Interview[]
  Referrals          Candidate[] // Candidates referred by this member
  SlackReferral      Referral[] // These are intermediate states required to create a referral using slack
  EmailTemplates     EmailTemplate[]
  Comments           Comment[]
}

type EncryptedData {
  iv   String
  text String
}

model Invitees {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  role        Role
  token       String    @default(uuid())
  createdAt   DateTime  @default(now())
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [memberId], references: [uid])
  memberId    String
}

enum Role {
  admin
  member
}

model Job {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  title         String?
  priority      Priority    @default(medium)
  affindaId     String?
  jdPdfUrl      String?
  Department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departmentId  String?     @db.ObjectId
  jobType       JobType?
  Location      Location?   @relation(fields: [locationId], references: [id])
  locationId    String?     @db.ObjectId
  isRemote      Boolean     @default(false)
  hiringManager String? // uid of user
  hireBy        DateTime?
  description   String?
  skills        String[]
  experience    String?
  currency      Currency?
  minSalary     Int?
  maxSalary     Int?
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  favorites     String[] // uid of users who have favorited this job
  Interview     Interview[]
  Workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  workspaceId   String      @db.ObjectId
  Member        Member      @relation(fields: [createdBy], references: [uid])
  createdBy     String
  Candidate     Candidate[]
  Prospects     Prospect[]  @relation(fields: [prospectIds], references: [id])
  prospectIds   String[]    @db.ObjectId
  Referral      Referral[]
}

enum Priority {
  high
  medium
  low
}

enum JobType {
  fullTime
  partTime
  contract
  internship
}

enum Currency {
  inr
  usd
}

// Intermediate step to create Referral
model Referral {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  lastName    String
  email       String
  phone       String
  linkedInUrl String?
  createdAt   DateTime @default(now())
  Job         Job      @relation(fields: [jobId], references: [id])
  jobId       String   @db.ObjectId
  slackUserId String?
  Member      Member   @relation(fields: [createdBy], references: [uid])
  createdBy   String
}

model Department {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Job         Job[]
}

model Location {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Job         Job[]
}

model Candidate {
  id                     String          @id @default(auto()) @map("_id") @db.ObjectId
  firstName              String
  middleName             String?
  lastName               String?
  email                  String
  phone                  String?
  location               String?
  resume                 String?
  skills                 String[]
  totalYearsOfExperience Int?
  currentCompany         String?
  education              Education[]
  experience             Experience[]
  source                 CandidateSource @default(jobBoard)
  affindaId              String          @unique
  linkedInUrl            String?
  matchScore             Int?
  status                 CandidateStatus @default(applied)
  rejectionReasons       String[]
  rejectionNotes         String?
  createdAt              DateTime        @default(now())
  Job                    Job             @relation(fields: [jobId], references: [id])
  jobId                  String          @db.ObjectId
  Workspace              Workspace       @relation(fields: [workspaceId], references: [id])
  workspaceId            String          @db.ObjectId
  Feedback               Feedback[]
  Calendar               Calendar[]
  Email                  Email[]
  Interview              Interview?      @relation(fields: [interviewId], references: [id])
  interviewId            String?         @db.ObjectId
  Referral               Member?         @relation(fields: [referredBy], references: [uid])
  referredBy             String?
  Comments               Comment[]
}

type Education {
  location  String?
  course    String?
  isCurrent Boolean?
  startDate DateTime?
  endDate   DateTime?
  institute String?
}

type Experience {
  location    String?
  isCurrent   Boolean?
  startDate   DateTime?
  endDate     DateTime?
  company     String?
  designation String?
}

enum CandidateSource {
  referral
  jobBoard
  linkedIn
  instahyre
  iimjobs
  naukri
  other
}

enum CandidateStatus {
  sourced
  applied
  interview
  offered
  accepted
  rejected
}

model Prospect {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  middleName  String?
  lastName    String
  email       String
  phone       String
  location    String
  resume      String?
  linkedInUrl String
  createdAt   DateTime  @default(now())
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  Jobs        Job[]     @relation(fields: [jobIds], references: [id])
  jobIds      String[]  @db.ObjectId
}

model Feedback {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  notes       String
  score       Float
  createdAt   DateTime  @default(now())
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
}

// Details of interview round with candidate
model Interview {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  order     Int
  Member    Member      @relation(fields: [createdBy], references: [uid])
  createdBy String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Candidate Candidate[]
  Job       Job         @relation(fields: [jobId], references: [id])
  jobId     String      @db.ObjectId
}

model Calendar {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String    @unique // eventId from google calendar
  title       String
  startTime   DateTime
  endTime     DateTime
  attendees   String[]
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  createdAt   DateTime  @default(now())
}

model Email {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId   String    @unique // id from gmail
  subject     String
  from        String
  to          String
  body        String
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  createdAt   DateTime  @default(now())
}

type Integration {
  gcal  App?
  gmail App?
  slack App?
}

type App {
  isInstalled Boolean
  createdAt   DateTime @default(now())
}

model EmailTemplate {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  subject     String
  body        String
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  content     Json
  createdAt   DateTime  @default(now())
  Member      Member    @relation(fields: [createdBy], references: [uid])
  createdBy   String
  Candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @db.ObjectId
}
